#	$NetBSD: Makefile.mbr,v 1.19 2014/01/12 15:26:29 tsutsui Exp $

S=		${.CURDIR}/../../../../..

NOMAN=		# defined

LIBCRT0=	# nothing
LIBCRTI=	# nothing
LIBCRTBEGIN=	# nothing
LIBCRTEND=	# nothing
LIBC=		# nothing

PIE_CFLAGS=
PIE_LDFLAGS=
PIE_AFLAGS=

.if defined(__MINIX)
USE_BITCODE=no
.endif # defined(__MINIX)

.include <bsd.own.mk>

STRIPFLAG=	# override

SRCS?=		mbr.S

BINDIR=		/usr/mdec
BINMODE=	444

.PATH:		${.CURDIR}/..

LDFLAGS+=	-nostdlib -Wl,-e,start
CPPFLAGS+=	-I. -I${.CURDIR}/../../lib -I${S}

.if ${MACHINE_ARCH} == "x86_64"
# Cross-building the 16/32-bit MBR code from the amd64 tree.  As in
# bootxx/Makefile.bootxx: target i586 (-m32 alone is ignored by the amd64
# clang wrapper), link statically at address 0 (the wrapper adds
# --image-base=0x400000 and a PT_INTERP otherwise; MBR_LDFLAGS goes after
# LDFLAGS so it wins), and use clang's integrated assembler, since there is
# no GNU as behind -no-integrated-as.
LDFLAGS+=	-static -Wl,-m,elf_i386
MBR_LDFLAGS=	-Wl,--image-base=0
AFLAGS+=	--target=i586-elf32-minix
MBR_INTEGRATED_AS=	yes
AFLAGS.gptmbr.S=	# gptmbr/Makefile sets -no-integrated-as before including us
.endif

BUILDSYMLINKS+=	$S/arch/i386/include	machine \
		$S/arch/x86/include	x86

DPSRCS+=	machine x86

CLEANFILES+=	${PROG}.tmp

LOADADDR=	0x8800

.if !defined(MBR_INTEGRATED_AS)
AFLAGS.mbr.S= ${${ACTIVE_CC} == "clang":?-no-integrated-as:}
AFLAGS.gpt.S= ${${ACTIVE_CC} == "clang":?-no-integrated-as:}
.endif

.if defined(__MINIX)
CPPFLAGS+= -DLOADADDR=${LOADADDR}
.endif # defined(__MINIX)

${PROG}: ${OBJS}
	${_MKTARGET_LINK}
.if defined(__MINIX)
	${CC} -o ${PROG}.tmp ${LDFLAGS} ${MBR_LDFLAGS} -Wl,--section-start=.text=${LOADADDR} ${OBJS}
.else
	${CC} -o ${PROG}.tmp ${LDFLAGS} -Wl,-Ttext,${LOADADDR} ${OBJS}
.endif # defined(__MINIX)
	@ set -- $$( ${NM} -t d ${PROG}.tmp | grep '\<mbr_space\>' \
		    | ${TOOL_SED} 's/^0*//'  ); \
		echo "#### There are $$1 free bytes in ${PROG}"
	${OBJCOPY} -O binary ${PROG}.tmp ${PROG}
	rm -f ${PROG}.tmp

.include <bsd.prog.mk>
