#!/bin/sh

# CD boottime initializations.

# Diagnostic markers — gated on verbose=2+ in the kernel boot command line.
_rccd_verbose=$(sysenv verbose 2>/dev/null)
: ${_rccd_verbose:=0}
rcv() { [ "${_rccd_verbose:-0}" -ge 2 ] 2>/dev/null && echo "$@"; }

rcv "RCCD: enter, pid=$$, args=$@"
echo -n "Creating writable directories:"

# Set up a ramdisk to make a read-only part of the directory tree writable
# $1 : ramdisk dev node to use
# $2 : path to make writeable
# $3 : ramdisk size in blocks
create_ramdisk()
{
	rcv "RCCD: create_ramdisk $1 $2 $3"
	echo -n " $2"
	ramdisk $3 /dev/$1 > /dev/null
	mkfs.mfs /dev/$1 > /dev/null

	# copy files
	rcv "RCCD:  about to mount /dev/$1 /mnt"
	mount /dev/$1 /mnt > /dev/null; r=$?
	rcv "RCCD:   mount /dev/$1 /mnt ret=$r"
	# -pe: keep the modes (sticky /var/shm, /var/mqueue, /var/mail ...)
	(cd $2 && pax -rw -pe . /mnt)

	rcv "RCCD:  about to umount /mnt"
	umount /mnt > /dev/null; r=$?
	rcv "RCCD:   umount /mnt ret=$r"
	rcv "RCCD:  about to mount /dev/$1 $2"
	mount /dev/$1 $2 > /dev/null; r=$?
	rcv "RCCD:   mount /dev/$1 $2 ret=$r"
}

# Make the writable parts of the tree tmpfs file systems.  tmpfs takes pages
# from VM only as files are written, so an idle live CD costs next to nothing
# and a desktop session gets what it writes, up to half of RAM per mount (the
# tmpfs default).  The fixed-size MFS ramdisks this replaces were reserved in
# full at boot: the desktop's 112 MB of them starved VM on machines just big
# enough to create them (a 128 MB machine ran out of memory while a 96 MB one,
# where they failed, booted).
#
# $1 : path to make writable
# $2 : mode of its root directory
# $3 : ramdisk dev node and $4 size in blocks, used only if tmpfs fails
#
# The CD's contents of the path are copied in.  Once tmpfs covers the path
# they are out of reach, so they are staged in /tmp first, which is mounted
# before the others (the CD's /tmp is empty).
create_tmpfs()
{
	rcv "RCCD: create_tmpfs $1 $2"
	echo -n " $1"
	_stage=
	if [ "$1" != /tmp ]; then
		_stage=/tmp/.rccd-stage
		mkdir -p $_stage && (cd $1 && pax -rw -pe . $_stage)
	fi
	if mount -t tmpfs -o mode=$2 none $1 > /dev/null; then
		if [ -n "$_stage" ]; then
			(cd $_stage && pax -rw -pe . $1)
		fi
		chmod $2 $1
	else
		echo -n " (tmpfs failed: ramdisk)"
		create_ramdisk $3 $1 $4
	fi
	if [ -n "$_stage" ]; then
		rm -rf $_stage
	fi
	return 0
}

create_tmpfs /tmp 1777 ram1 2048
create_tmpfs /var 755 ram0 8192
create_tmpfs /usr/run 755 ram2 2048
create_tmpfs /root 700 ram3 8192

echo
